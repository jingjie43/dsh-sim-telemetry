{
  "name": "dsh-sim-telemetry",
  "version": "0.3.2",
  "description": "F1 25 遥测分析插件：12 条赛道 211 弯校准、逐弯诊断、比赛工程师报告（DSH 插件）",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "client.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node -e \"console.log('dsh-sim-telemetry: plain JavaScript plugin, no build step needed')\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  }
}
